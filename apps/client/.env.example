# Copy to .env and adjust. Every value is optional; the defaults are what the app uses without it.
# Expo reads EXPO_PUBLIC_* at build/start time: restart `npx expo start` after changing this file.
# These end up in the app bundle, so never put secrets here (Cognito pool/client IDs are not secrets).

# API base URL. Default: http://localhost:3000 (http://10.0.2.2:3000 on the Android emulator).
# On a phone, use your computer's LAN address, e.g. http://192.168.1.20:3000
# EXPO_PUBLIC_API_URL=

EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_irm6sACmh
EXPO_PUBLIC_COGNITO_CLIENT_ID=41cteuobnc1299nlkuh3ei15kc
EXPO_PUBLIC_COGNITO_DOMAIN=us-east-2irm6sacmh.auth.us-east-2.amazoncognito.com
# Comma-separated
EXPO_PUBLIC_AUTH_REDIRECT_URLS=http://localhost:8081/,exp://localhost:8081
