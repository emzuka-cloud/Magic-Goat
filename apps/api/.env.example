# Copy to .env and adjust. Every value is optional; the defaults below are what the code uses without it.
# Loaded by src/load-env.ts (Node's built-in .env loader); real environment variables take precedence.

PORT=3000

# PostgreSQL (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mtg_user
POSTGRES_PASSWORD=mtg_password
POSTGRES_DB=mtg_db

# AWS Cognito: only ID tokens from this pool and app client are accepted.
COGNITO_USER_POOL_ID=us-east-2_irm6sACmh
COGNITO_CLIENT_ID=41cteuobnc1299nlkuh3ei15kc

# Browser origins allowed to call the API (comma-separated). Native apps are not affected.
CORS_ORIGINS=http://localhost:8081

# npm run seed: also create a play group and league owned by this (signed-in-once) username.
# SEED_OWNER=
